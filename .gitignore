# Локальные файлы, которых нет в репозитории
# bin/ не игнорируем целиком: bin/ffmpeg.7z едет в репозитории,
# сборка распаковывает его в bin/ffmpeg.exe и вшивает в установщик.
bin/*
!bin/ffmpeg.7z
lib/
*.log
mic_debug_raw.txt
mic_debug_hex.txt
mic_result.txt
ffmpeg_log.txt
error.log
.screen_recorder.lock
.screen_recorder.pid

# activation key build output
act_key.exe
act_key.obj
act_key.res
